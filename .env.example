# ZORA — safe defaults. Copy to .env. Paper trading unless ALL live conditions below are met.
EXCHANGE_ID=htx                  # binance | bybit | okx | htx
SYMBOL=ETH/USDT
SYMBOLS=ETH/USDT
TIMEFRAMES=15m,1h,4h
BTC_CONTEXT_SYMBOL=BTC/USDT

# ---- Live trading: stays locked unless LIVE_TRADING, I_UNDERSTAND_THE_RISK AND the keys are all set ----
LIVE_TRADING=false
I_UNDERSTAND_THE_RISK=false
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=           # OKX (and a few others) only
# Optional per-exchange credentials (used instead of the EXCHANGE_* ones for that exchange)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=
HTX_API_KEY=
HTX_API_SECRET=
HTX_API_PASSWORD=
NATIVE_PROTECTION_REQUIRED=true  # refuse live entries that cannot get exchange-side stop/take-profit
RECONCILE_ON_START=true

# ---- Capital and risk (hard limits; no signal, AI or learned weight can override them) ----
STARTING_CAPITAL=1000
RISK_PER_TRADE_PCT=0.5
MAX_EXPOSURE_PCT=30
MAX_DAILY_LOSS_PCT=3
MAX_DRAWDOWN_PCT=15
ALLOW_SHORTS=false

# ---- Costs used by paper mode and backtests ----
FEE_RATE=0.001
SLIPPAGE_BPS=5
EXECUTION_LATENCY_MS=250

POLL_SECONDS=60
DB_PATH=zora.db
LOG_LEVEL=INFO

# ---- Dashboard (0 = off). Keep it on 127.0.0.1: it has no login. ----
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=0

# ---- Optional AI panel (advisory votes only; leave blank to skip) ----
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Optional Telegram alerts + remote control ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_IDS=

# ---- Optional TradingView webhook (needs DASHBOARD_PORT != 0 and a 16+ character secret) ----
TV_WEBHOOK_SECRET=

PAPER_VALIDATION_DAYS=30

# AI safety
AI_ENTRY_BLOCK_ON_UNAVAILABLE=true
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_DAILY_CALL_LIMIT=0
AI_MINUTE_CALL_LIMIT=0

# Free-tier AI and trade limits (daily AI budget counts outbound provider HTTP requests)
MAX_TRADES_PER_DAY=5
MIN_AI_CALL_INTERVAL_SECONDS=900
MAX_AI_CALLS_PER_DAY=96
AI_MINUTE_CALL_LIMIT=10
AI_CYCLE_TIMEOUT_SECONDS=45
